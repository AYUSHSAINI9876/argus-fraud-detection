# ─── Environment ──────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Auth (Stack Auth) ────────────────────────────────────────────────────
# Create a project at https://app.stack-auth.com and paste the keys here.
# Leave AUTH_ENABLED=false to run locally without a Stack Auth project —
# the API injects a synthetic ADMIN user. This flag is force-rejected when
# ENVIRONMENT=production, so it cannot leave production unprotected.
AUTH_ENABLED=false
STACK_PROJECT_ID=
STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# ─── Datastores ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus
REDIS_URL=redis://localhost:6379/0

# ─── Models ───────────────────────────────────────────────────────────────
CHAMPION_MODEL=xgboost_risk
CHALLENGER_MODEL=logistic_baseline
ANOMALY_MODEL=gaussian_anomaly

# ─── LLM analyst copilot ──────────────────────────────────────────────────
COPILOT_ENABLED=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# ─── Email alerts ─────────────────────────────────────────────────────────
# Provider-agnostic. "console" prints to stdout — fine for local development.
EMAIL_PROVIDER=console
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=Argus Alerts <alerts@argus.local>

# ─── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
