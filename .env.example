# ─── Environment ──────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Auth (Stack Auth) ────────────────────────────────────────────────────
# Create a project at https://app.stack-auth.com and paste the keys here.
# Leave AUTH_ENABLED=false to run locally without a Stack Auth project —
# the API injects a synthetic ADMIN user. This flag is force-rejected when
# ENVIRONMENT=production, so it cannot leave production unprotected.
AUTH_ENABLED=false
STACK_PROJECT_ID=
STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# ─── Datastores ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus
REDIS_URL=redis://localhost:6379/0

# ─── Models ───────────────────────────────────────────────────────────────
CHAMPION_MODEL=xgboost_risk
CHALLENGER_MODEL=logistic_baseline
ANOMALY_MODEL=gaussian_anomaly

# ─── LLM analyst copilot ──────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY blank to run without the copilot — the case page
# simply serves no narrative, and everything else works unchanged.
COPILOT_ENABLED=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Effort is the main cost/latency lever: low | medium | high | xhigh | max.
LLM_EFFORT=low

# ─── Email alerts ─────────────────────────────────────────────────────────
# Provider-agnostic. "console" prints to stdout — fine for local development.
EMAIL_PROVIDER=console
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=Argus Alerts <alerts@argus.local>

# ─── Frontend ─────────────────────────────────────────────────────────────
# Leaving NEXT_PUBLIC_STACK_PROJECT_ID blank runs the console in local mode:
# it signs you in as a synthetic ADMIN and shows an "Auth disabled" banner,
# mirroring the API's AUTH_ENABLED=false. Setting it switches real sign-in
# back on. A production build refuses to serve without it.
#
# API_URL is read server-side at request time and wins over
# NEXT_PUBLIC_API_URL when set. The console only ever calls the API from the
# server, so use API_URL wherever the address differs between build and run —
# docker-compose sets it to http://api:8000/api/v1 for the internal network.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
